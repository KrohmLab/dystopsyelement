---
/** Icônes des réseaux sociaux (Lucide n'en fournit plus) : tracé 1.5 px, même gabarit 24 × 24. */
export type Network = "instagram" | "facebook" | "soundcloud" | "youtube";

interface Props {
  network: Network;
  class?: string;
}

const { network, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {network === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
    </>
  )}
  {network === "facebook" && (
    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
  )}
  {network === "soundcloud" && <path d="M2 15v2M5 12v5M8 10v7M11 8v9M14 7h3a4 4 0 0 1 0 8h-3z" />}
  {network === "youtube" && (
    <>
      <path d="M2.5 17a24 24 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.6 49.6 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24 24 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.6 49.6 0 0 1-16.2 0A2 2 0 0 1 2.5 17" />
      <path d="m10 15 5-3-5-3z" />
    </>
  )}
</svg>
