---
/**
 * Pied de page (DESIGN_SYSTEM §7.3) : marque + phrase + réseaux · navigation · contact, puis barre légale.
 * Liens réels uniquement : un réseau, une phrase ou un e-mail absent de `site.ts` n'est pas affiché.
 */
import { site } from "../../data/site.ts";
import type { NavItem, Ticket } from "../../lib/navigation.ts";
import Icon from "../ui/Icon.astro";
import SocialIcon, { type Network } from "../ui/SocialIcon.astro";
import Logo from "./Logo.astro";

interface Props {
  nav: NavItem[];
  ticket: Ticket;
}

const { nav, ticket } = Astro.props;

const networkLabels: Record<Network, string> = {
  instagram: "Instagram",
  facebook: "Facebook",
  soundcloud: "SoundCloud",
  youtube: "YouTube",
};
const socials = (Object.keys(networkLabels) as Network[])
  .map((network) => ({ network, label: networkLabels[network], href: site.socials[network] }))
  .filter((social): social is typeof social & { href: string } => !!social.href);

const contact: NavItem[] = [
  { label: "Formulaire", href: "/contact" },
  { label: "Billetterie", href: ticket.href, external: ticket.external },
  ...(site.shopUrl ? [{ label: "Boutique", href: site.shopUrl, external: true }] : []),
  ...(site.email ? [{ label: site.email, href: `mailto:${site.email}` }] : []),
];

const columns = [
  { title: "Navigation", links: nav },
  { title: "Contact", links: contact },
];
const year = new Date().getFullYear();
const heading = "mb-4 font-display text-eyebrow font-bold text-cyan uppercase";
const link =
  "inline-flex items-center gap-1 text-ink-muted transition-colors duration-fast hover:text-ink";
---

<footer class="border-t border-cyan-line bg-void px-gutter pt-14 pb-7">
  <div class="mx-auto max-w-site">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-3 text-ink"
          aria-label={`${site.name}, accueil`}
        >
          <Logo class="size-10" />
          <span class="font-display text-label font-bold uppercase">{site.name}</span>
        </a>
        {site.tagline && <p class="mt-4 max-w-prose text-ink-soft">{site.tagline}</p>}
        {socials.length > 0 && (
          <ul class="mt-5 flex gap-2.5">
            {socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/social block size-11 bg-cyan-line p-px transition-colors duration-base chamfer-sm hover:bg-cyan"
                >
                  <span class="grid size-full place-items-center bg-void text-cyan transition-colors duration-base chamfer-sm group-hover/social:bg-cyan group-hover/social:text-on-accent">
                    <SocialIcon network={social.network} />
                  </span>
                  <span class="sr-only">{social.label} (nouvel onglet)</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      {columns.map((column) => (
        <div>
          <h2 class={heading}>{column.title}</h2>
          <ul class="grid gap-2">
            {column.links.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={link}
                  {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {item.label}
                  {item.external && <Icon name="arrow-up-right" size={16} />}
                  {item.external && <span class="sr-only">(nouvel onglet)</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap justify-between gap-x-6 gap-y-3 border-t border-line pt-5 text-small text-ink-muted">
      <span>
        © {year} {site.name}
      </span>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href="/mentions-legales" class={link}>
            Mentions légales
          </a>
        </li>
        <li>
          <a href="/mentions-legales#credits" class={link}>
            Crédits photos
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
