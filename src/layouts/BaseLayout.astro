---
import "@fontsource-variable/orbitron/wght.css";
import "@fontsource/rajdhani/latin-500.css";
import "@fontsource/rajdhani/latin-600.css";
import "@fontsource/rajdhani/latin-700.css";
import "../styles/global.css";
import orbitron from "@fontsource-variable/orbitron/files/orbitron-latin-wght-normal.woff2?url";
import rajdhani from "@fontsource/rajdhani/files/rajdhani-latin-500-normal.woff2?url";
import { site } from "../data/site.ts";
import { buildSeo } from "../lib/seo.ts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
const seo = buildSeo({ title, description, image, noindex, path: Astro.url.pathname });
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    {seo.description && <meta name="description" content={seo.description} />}
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#020202" />

    <link rel="preload" href={orbitron} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={rajdhani} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:url" content={seo.canonical} />
    {seo.description && <meta property="og:description" content={seo.description} />}
    {seo.image && <meta property="og:image" content={seo.image} />}
    <meta name="twitter:card" content={seo.image ? "summary_large_image" : "summary"} />
  </head>
  <body class="min-h-svh">
    <main id="contenu">
      <slot />
    </main>
  </body>
</html>
